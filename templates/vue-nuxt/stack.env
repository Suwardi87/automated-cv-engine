DISPLAY_NAME="Nuxt 4 + NestJS Monorepo"
DESCRIPTION="Fullstack monorepo: Nuxt 4 (SSR/Vue 3) + NestJS (REST API)"
DETECT_FILES="package.json"
DETECT_EXCLUDE=""
DETECT_PRIORITY=10

# Package manager: cek lockfile urut (install di frontend-cms, bukan root)
PACKAGE_MANAGER_DETECT="frontend-cms/package-lock.json:(cd frontend-cms && npm ci)"
PACKAGE_MANAGER_FALLBACK="(cd frontend-cms && npm install)"

# Monorepo: lint + typecheck untuk frontend (Nuxt) + backend (NestJS)
# NOTE: wajib subshell ( ) supaya cwd tidak bocor antar LINT/TYPECHECK/TEST
LINT_CMD="(cd frontend-cms && npx nuxi typecheck)"
TYPECHECK_CMD="(cd backend && npx nest build)"
TEST_CMD="(cd backend && npm run test --if-present)"

# Security
SECURITY_AUDIT_CMD="npm audit --audit-level=moderate 2>/dev/null || true"
SECURITY_HTML_CMD=""
SECURITY_EXTRA_CMD=""

# Version source: file-based (VERSION file)
VERSION_SOURCE="file"
VERSION_FILE="VERSION"
